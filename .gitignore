# Ignore video and audio files
*.mp4
*.mp3
*.avi
*.mkv
*.mov
*.wav
*.m4a
*.flac
*.ogg
*.webm
*.wmv
*.flv
*.ts
*.m2ts

# Ignore large generated outputs
*.zip
*.tar.gz
*.rar

# Ignore temp/intermediate files
*.tmp
*.log
*.err
__pycache__/
*.pyc
.venv/
venv/

# Track databases (catalog + agent memory) — small, non-sensitive, required history
# (no *.db ignore by policy)

# Machine-local sync markers — never commit
.stfolder

# Keep memory and sessions tracked
!/.hypernexus/
!/.mimocode/

# Topaz 4K upscale artifacts (see TOPAZ_4K_UPSCALE.md) — proprietary binaries
# and downloaded models are recreated from the Topaz MSI, never committed
topaz-extract/
topaz-redist/
topaz-models/
topaz-models-min/
topaz_probe*.exe
topaz_*.out
topaz_*frame*.png
upscale_out/
upscale_segments/
